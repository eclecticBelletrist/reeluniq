# reeluniq settings. Remove the # at the start of a line to turn it on, then restart the program.
# Настройки reeluniq. Уберите # в начале строки, чтобы включить настройку, и перезапустите программу.

# Language of the page and the window: auto (follow the system), ru, en
# Язык страницы и окна: auto (как в системе), ru, en
# REELUNIQ_LANG=auto

# Mode: light, dust, operator, meta
# Режим: light, dust, operator, meta
# REELUNIQ_MODE=light

# Number of variants (1 or more; the page offers up to 8)
# Число версий (1 и больше; страница предлагает до 8)
# REELUNIQ_COUNT=3

# Folder for the results of the make and watch commands (the page keeps its own)
# Папка для результатов команд make и watch (страница хранит файлы у себя)
# REELUNIQ_OUT=

# Page address and port; host 0.0.0.0 opens it to the local network and then asks for a PIN
# Адрес и порт страницы; адрес 0.0.0.0 открывает её для локальной сети, тогда нужен PIN
# REELUNIQ_HOST=127.0.0.1
# REELUNIQ_PORT=8765
# REELUNIQ_PIN=

# Open the page in the browser on start: yes or no
# Открывать страницу в браузере при запуске: yes или no
# REELUNIQ_BROWSER=yes
